# Local settings (contains permissions, may contain tokens)
settings.local.json

# Work context (machine-specific current problem/phase)
.workcontext

# Session telemetry (ephemeral, processed by session-end)
.session-errors
.session-reads
.session-reads-meta
.session-edits
.session-activity
.session-heads

# Scheduled-task coordination lock (runtime artifact of ScheduleWakeup,
# managed by Claude Code itself — must not be committed)
scheduled_tasks.lock

# Agent-specific memory/cache (machine-local)
agent-memory/
