{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(cargo *)",
      "Bash(just *)",
      "Bash(just)",
      "Bash(glab *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(chmod *)",
      "Bash(mkdir *)",
      "Bash(cd *)",
      "Bash(xargs *)",
      "Bash(which *)",
      "Bash(command *)",
      "Bash(env)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(./gradlew *)",
      "Bash(brew list:*)",
      "Bash(brew install:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(xcodegen:*)",
      "Bash(adb:*)",
      "Bash(reuse lint:*)",
      "Bash(cmake:*)",
      "Bash(du:*)",
      "Bash(python3:*)",
      "Bash(bash:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(rm:*)",
      "Bash(touch:*)",
      "Bash(realpath:*)",
      "Bash(shasum:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(curl:*)",
      "Read(/)",
      "Read(/**)",
      "Read(/**/**)",
      "Write(/)",
      "Write(/**)",
      "Write(/**/**)",
      "WebSearch",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:gtk-rs.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:kotlinlang.org)",
      "WebFetch(domain:swift.org)",
      "WebFetch(domain:tauri.app)",
      "WebFetch(domain:docs.solidjs.com)",
      "WebFetch(domain:mozilla.github.io)",
      "WebFetch(domain:docs.gtk.org)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:just.systems)",
      "WebFetch(domain:docs.gitlab.com)",
      "Bash(docker run:*)",
      "Bash(glab mr:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/bootstrap.sh",
            "timeout": 30,
            "statusMessage": "Running environment health check..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/require-workcontext.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate-push.sh",
            "timeout": 300,
            "statusMessage": "Running pre-push checks..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-bash-grep.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-cd-git.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-use-just.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-stale-commit.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh",
            "statusMessage": "Checking & formatting..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/log-bash-errors.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/log-read-patterns.sh",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false
  }
}
