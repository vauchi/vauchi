{
  "permissions": {
    "allow": [
      "Bash(git :*)",
      "Bash(cargo :*)",
      "Bash(just :*)",
      "Bash(just)",
      "Bash(glab :*)",
      "Bash(ls :*)",
      "Bash(ls)",
      "Bash(find :*)",
      "Bash(grep :*)",
      "Bash(wc :*)",
      "Bash(head :*)",
      "Bash(tail :*)",
      "Bash(sort :*)",
      "Bash(diff :*)",
      "Bash(cat :*)",
      "Bash(echo :*)",
      "Bash(chmod :*)",
      "Bash(mkdir :*)",
      "Bash(cd :*)",
      "Bash(xargs :*)",
      "Bash(which :*)",
      "Bash(command :*)",
      "Bash(env)",
      "Bash(npm :*)",
      "Bash(npx :*)",
      "Bash(./gradlew :*)",
      "Read(/)",
      "Read(/**)",
      "Read(/**/**)",
      "WebSearch",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:gtk-rs.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:kotlinlang.org)",
      "WebFetch(domain:swift.org)",
      "WebFetch(domain:tauri.app)",
      "WebFetch(domain:docs.solidjs.com)",
      "WebFetch(domain:mozilla.github.io)",
      "WebFetch(domain:docs.gtk.org)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:just.systems)",
      "WebFetch(domain:docs.gitlab.com)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/bootstrap.sh",
            "timeout": 30,
            "statusMessage": "Running environment health check..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate-push.sh",
            "timeout": 300,
            "statusMessage": "Running pre-push checks..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-bash-grep.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-cd-git.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh",
            "statusMessage": "Checking & formatting..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true
  }
}
