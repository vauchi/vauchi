# E2E Testing Configuration
# Source this file or let orchestrate.sh load it automatically
#
# Override these by setting environment variables or editing this file.

# ═══════════════════════════════════════════════════════════════
# macOS VM (SSH)
# ═══════════════════════════════════════════════════════════════
MACOS_SSH_HOST="${MACOS_SSH_HOST:-localhost}"
MACOS_SSH_PORT="${MACOS_SSH_PORT:-2222}"
MACOS_SSH_USER="${MACOS_SSH_USER:-user}"

# ═══════════════════════════════════════════════════════════════
# iOS Configuration
# ═══════════════════════════════════════════════════════════════
IOS_SIMULATOR="${IOS_SIMULATOR:-iPhone 17 Pro}"
IOS_BUNDLE_ID="${IOS_BUNDLE_ID:-app.vauchi.ios}"
# Path on macOS VM - uses glob for DerivedData hash
IOS_APP_PATH="${IOS_APP_PATH:-Library/Developer/Xcode/DerivedData/Vauchi-*/Build/Products/Debug-iphonesimulator/Vauchi.app}"

# ═══════════════════════════════════════════════════════════════
# Android Configuration
# ═══════════════════════════════════════════════════════════════
ANDROID_PACKAGE="${ANDROID_PACKAGE:-com.vauchi}"
ANDROID_ACTIVITY="${ANDROID_ACTIVITY:-.MainActivity}"
ANDROID_APK_PATH="${ANDROID_APK_PATH:-android/app/build/outputs/apk/debug/app-debug.apk}"
ANDROID_AVD_NAME="${ANDROID_AVD_NAME:-Pixel_7}"

# Qt platform for emulator (xcb for X11/Wayland compatibility)
# Options: xcb, wayland, offscreen, vnc
ANDROID_QT_PLATFORM="${ANDROID_QT_PLATFORM:-xcb}"

# ═══════════════════════════════════════════════════════════════
# Relay Configuration
# ═══════════════════════════════════════════════════════════════
# Production relay (default - simpler, no setup needed)
RELAY_URL="${RELAY_URL:-wss://relay.vauchi.app}"

# Set to true to use local TLS relay instead of production
USE_LOCAL_RELAY="${USE_LOCAL_RELAY:-false}"

# Local relay settings (when USE_LOCAL_RELAY=true)
LOCAL_RELAY_PORT="${LOCAL_RELAY_PORT:-8080}"
LOCAL_RELAY_TLS_PORT="${LOCAL_RELAY_TLS_PORT:-8443}"

# ═══════════════════════════════════════════════════════════════
# Output and Logging
# ═══════════════════════════════════════════════════════════════
E2E_SCREENSHOTS_DIR="${E2E_SCREENSHOTS_DIR:-tmp/e2e-screenshots}"
E2E_LOGS_DIR="${E2E_LOGS_DIR:-tmp/e2e-logs}"
