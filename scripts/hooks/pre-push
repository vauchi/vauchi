#!/bin/bash
# Pre-push hook: Run tests before pushing
# Install with: ./install-hooks.sh
#
# This hook runs tests to catch issues before they reach CI.
# Skip with: git push --no-verify

set -e

echo "=== Pre-push checks ==="

# Only run full checks if pushing to main or develop
remote="$1"
url="$2"

# Read stdin for refs being pushed
while read local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" =~ refs/heads/(main|develop|master) ]]; then
        echo "Pushing to protected branch: ${remote_ref#refs/heads/}"
        echo "Running full test suite..."

        # Run Rust tests
        if command -v cargo &> /dev/null && [[ -d "code" ]]; then
            echo "[1/2] Running Rust tests..."
            cd code
            if ! cargo test --workspace 2>&1 | tail -20; then
                echo ""
                echo "ERROR: Tests failed. Push blocked."
                echo "Fix the failing tests before pushing to $remote_ref"
                exit 1
            fi
            cd ..
            echo "  Rust tests passed"
        fi

        # Run clippy
        if command -v cargo &> /dev/null && [[ -d "code" ]]; then
            echo "[2/2] Running clippy..."
            cd code
            if ! cargo clippy --workspace -- -D warnings 2>&1 | tail -10; then
                echo ""
                echo "WARNING: Clippy warnings detected."
                echo "Consider fixing these before pushing."
                # Don't block - just warn
            fi
            cd ..
            echo "  Clippy check complete"
        fi

        echo ""
        echo "=== Pre-push checks passed ==="
    else
        echo "Pushing to feature branch, running quick checks only..."

        # Just check formatting on feature branches
        if command -v cargo &> /dev/null && [[ -d "code" ]]; then
            cd code
            if ! cargo fmt --all -- --check 2>/dev/null; then
                echo ""
                echo "WARNING: Code is not formatted."
                echo "Run 'cargo fmt --all' to fix."
                # Don't block feature branches for formatting
            fi
            cd ..
        fi

        echo "=== Quick checks complete ==="
    fi
done

exit 0
