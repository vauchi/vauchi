# Vauchi Meta Repo
# This repo only tracks top-level workspace files.
# All subdirectories are separate git repositories.

# ===========================================
# Ignore all subdirectories (separate repos)
# ===========================================
/android/
/core/
/relay/
/cli/
/tui/
/desktop/
/e2e/
/features/
/ios/
/locales/
/docs/
/website/
/scripts/
/assets/
/gitlab-profile/

# ===========================================
# Private content (not mirrored to GitHub)
# ===========================================
/_private/

# ===========================================
# Ignore generated/cache directories
# ===========================================
/tmp/
/cache/
/target/
/.gitlab-ci-local/
/builds/
/node_modules/

# ===========================================
# Local/machine-specific directories
# ===========================================
/_VMs/
/gitlab-profile/
/vauchi-mobile-android/
/vauchi-mobile-swift/



# ===========================================
# Track these top-level files (implicit)
# ===========================================
# - justfile
# - .gitignore
# - .gitlab-ci.yml
# - .github/
# - .changeset/
# - .pre-commit-config.yaml
# - package.json
# - package-lock.json
# - CLAUDE.md (symlink)
# - CONTRIBUTING.md (symlink)

# IDE configs
.cody/
.continue/
.cursor/
.kamal/
.idea/
.ai/
# .claude/ is tracked (skills, agents, shared settings)
# .claude/settings.local.json is excluded via .claude/.gitignore

*secret*
*.evn*
.env
.kamal/secret
.kamal/secrets
vauchi.code-workspace

# macOS
.DS_Store
