# Vauchi Meta Repo
# This repo only tracks top-level workspace files.
# All subdirectories are separate git repositories.

# ===========================================
# Ignore all subdirectories (separate repos)
# ===========================================
/android/
/core/
/relay/
/cli/
/tui/
/desktop/
/e2e/
/gtk-display/
/linux-gtk/
/qt-display/
/linux-qt/
/macos/
/windows/
/web-demo/
/features/
/ios/
/locales/
/themes/
/docs/
/spec/
/website/
/scripts/
/assets/
/gitlab-profile/
/ohttp-relay/
/linux-hw/
/linux-app/
/apple-hw/
/apple-display/
/android-hw/
/windows-hw/
/contract/

# ===========================================
# Private content (not mirrored to GitHub)
# ===========================================
/_private/

# ===========================================
# Ignore generated/cache directories
# ===========================================
/.worktrees/
/.slot.lock
/.branch-name
/.superpowers/
/data/
/tmp/
/cache/
/target/
/.gitlab-ci-local/
/builds/
/node_modules/

# ===========================================
# Sub-repos not in primary clone list
# ===========================================
/github-profile/
/vauchi-platform-kotlin/
/vauchi-platform-swift/

# ===========================================
# Local/machine-specific directories
# ===========================================
/_VMs/
/Visual-Regression-Tracker/



# ===========================================
# Track these top-level files (implicit)
# ===========================================
# - justfile
# - .gitignore
# - .gitlab-ci.yml
# - .github/
# - CLAUDE.md, KIMI.md, and AGENTS.md
# - .claude and .kimi-code (symlinks into _private)
# - .codex and .agents (real dirs of symlinks — a symlinked root makes
#   bubblewrap refuse to start Codex's sandbox; see just/codex-layout-lib.sh)
# - CONTRIBUTING.md (symlink)

# IDE / AI agent configs
.cody/
.continue/
.cursor/
.kamal/
.ai/
# .idea/ tracks a curated subset (run configs, scopes, code style, copyright,
# templates, excludes); per-user churn is excluded via .idea/.gitignore
# AI memory and local session state
.junie/
# .claude/ is tracked (skills, agents, shared settings)
# .claude/settings.local.json is excluded via .claude/.gitignore

# Secrets and credentials
.env
.env.*
*.secret
*.secrets
secrets.yml
secrets.yaml
credentials.json
service-account*.json
*.pem
*.key
*.p12
.kamal/secret
.kamal/secrets
/keys/
# vauchi.code-workspace is tracked (team IDE config)

# Drift detector (local MCP server)
/utils/drift-detector/
.drift.db
.drift.db-shm
.drift.db-wal


/utils/markdown-plan/
/utils/rqrr/
/utils/spake2/
/kanban-todo/

# Device testing screenshots
screenshot-*.png

# iOS device bridge caches
idb-*/

# Package manager — npm only (yarn.lock removed)
yarn.lock

# macOS
.DS_Store
cli/.cargo/config.toml
relay/.cargo/config.toml

# Local semantic search index (just semindex / semsearch)
.cache/

# Accidental absolute-path build output — a build wrote to $PWD/Users/...
# instead of an absolute /Users/... path, nesting artifacts inside the repo.
/Users/

# Local macOS log captures (device/system debugging, e.g. `log collect`)
/system_logs.logarchive/

# Output of _private/docs/testing/device-automation/capture-hover-*.sh —
# default OUT filename, its example `log collect` archive, and the
# two-sided capture's per-device log dir.
/hover-run.log
/ios.logarchive/
/hover-capture/

# Local BLE identity artifact written by the desktop/mobile apps during
# device testing. Contains privateKey and irk — key material that must
# never enter git.
selfIdentity.plist

# Python bytecode from the tests/ recipe suite. Untracked .pyc files fail
# `reuse lint`, which gate-push runs, so a test run blocks the next push.
__pycache__/
*.pyc
