# Vauchi Meta Repo
# This repo only tracks top-level workspace files.
# All subdirectories are separate git repositories.

# ===========================================
# Ignore all subdirectories (separate repos)
# ===========================================
/android/
/core/
/relay/
/cli/
/tui/
/desktop/
/e2e/
/linux-gtk/
/linux-qt/
/macos/
/windows/
/web-demo/
/features/
/ios/
/locales/
/themes/
/docs/
/website/
/scripts/
/assets/
/gitlab-profile/

# ===========================================
# Private content (not mirrored to GitHub)
# ===========================================
/_private/

# ===========================================
# Ignore generated/cache directories
# ===========================================
/.worktrees/
/data/
/tmp/
/cache/
/target/
/.gitlab-ci-local/
/builds/
/node_modules/

# ===========================================
# Local/machine-specific directories
# ===========================================
/_VMs/
/github-profile/
/vauchi-platform-kotlin/
/vauchi-platform-swift/



# ===========================================
# Track these top-level files (implicit)
# ===========================================
# - justfile
# - .gitignore
# - .gitlab-ci.yml
# - .github/
# - .changeset/
# - .pre-commit-config.yaml
# - package.json
# - package-lock.json
# - CLAUDE.md (symlink)
# - CONTRIBUTING.md (symlink)

# IDE configs
.cody/
.continue/
.cursor/
.kamal/
.idea/
.ai/
# .claude/ is tracked (skills, agents, shared settings)
# .claude/settings.local.json is excluded via .claude/.gitignore

# Secrets and credentials
.env
.env.*
*.secret
*.secrets
secrets.yml
secrets.yaml
credentials.json
service-account*.json
*.pem
*.key
*.p12
.kamal/secret
.kamal/secrets
vauchi.code-workspace

# Drift detector (local MCP server)
/drift-detector/
.drift.db
.drift.db-shm
.drift.db-wal


/markdown-plan/

# Device testing screenshots
screenshot-*.png

# macOS
.DS_Store
