# Vauchi Meta Repo
# This repo only tracks top-level workspace files.
# All subdirectories are separate git repositories.

# ===========================================
# Ignore all subdirectories (separate repos)
# ===========================================
/android/
/core/
/relay/
/cli/
/tui/
/desktop/
/e2e/
/dev-tools/
/features/
/ios/
/infra/

# ===========================================
# Private repos (not mirrored to GitHub)
# ===========================================
/private_repos/


# ===========================================
# Ignore generated/cache directories
# ===========================================
/tmp/
/cache/
/target/
# Node
/node_modules/



# ===========================================
# Track these top-level files (implicit)
# ===========================================
# - justfile
# - .gitignore
# - .gitlab-ci.yml
# - .github/
# - .changeset/
# - .pre-commit-config.yaml
# - package.json
# - package-lock.json
# - CLAUDE.md (symlink)
# - CONTRIBUTING.md (symlink)

