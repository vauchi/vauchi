# EditorConfig — shared indentation & whitespace across every editor
# (IntelliJ IDEA, VS Code, Junie, …) and language in the vauchi workspace.
# Baseline lives in the root meta repo; a sub-repo may add its own
# `.editorconfig` to override. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust — matches rustfmt defaults
[*.rs]
indent_size = 4

# TOML / YAML / JSON / web & JS-TS — 2-space house style (taplo/prettier)
[*.{toml,yml,yaml,json,jsonc,js,jsx,ts,tsx,mjs,cjs,html,css,scss,vue,svelte}]
indent_size = 2

# Kotlin / Swift / C / C++ / C#
[*.{kt,kts,swift,c,h,cpp,hpp,cc,cxx,cs}]
indent_size = 4

# Python — PEP 8
[*.py]
indent_size = 4

# Shell scripts
[*.sh]
indent_size = 4

# Markdown — keep trailing spaces (hard line breaks) but still end with a newline
[*.md]
trim_trailing_whitespace = false

# Makefiles require literal tabs
[{Makefile,*.mk}]
indent_style = tab

# Justfiles
[{justfile,*.just}]
indent_size = 4
