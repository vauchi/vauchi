{
  "folders": [
    {
      "path": ".",
      "name": "vauchi (root)"
    },
    {
      "path": "core",
      "name": "core"
    },
    {
      "path": "cli",
      "name": "cli"
    },
    {
      "path": "tui",
      "name": "tui"
    },
    {
      "path": "relay",
      "name": "relay"
    },
    {
      "path": "e2e",
      "name": "e2e"
    },
    {
      "path": "docs",
      "name": "docs"
    },
    {
      "path": "website",
      "name": "website"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/target": true,
      "**/.DS_Store": true,
      "**/*.snap.new": true
    },
    "files.associations": {
      "*.feature": "gherkin"
    },
    "search.exclude": {
      "**/target": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/.worktrees": true,
      "**/tmp": true,
      "**/cache": true,
      "LICENSES/**": true,
      "**/coverage": true
    },

    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.minimap.enabled": false,
    "editor.scrollBeyondLastLine": false,
    "editor.renderWhitespace": "none",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.stickyScroll.enabled": true,
    "editor.lineNumbers": "relative",

    "breadcrumbs.enabled": true,
    "workbench.editor.showTabs": "multiple",
    "workbench.activityBar.location": "bottom",

    "errorLens.delay": 500,
    "errorLens.fontStyleItalic": true,
    "errorLens.messageMaxChars": 100,
    "errorLens.enabledDiagnosticLevels": ["error", "warning"],
    "errorLens.excludeBySource": ["ts(6133)", "ts(6196)"],
    "errorLens.exclude": ["**/node_modules/**", "**/target/**", "**/dist/**"],

    "gitlens.codeLens.enabled": false,
    "gitlens.currentLine.enabled": false,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.hovers.enabled": true,
    "gitlens.statusBar.enabled": true,
    "gitlens.statusBar.command": "gitlens.toggleFileBlame",
    "gitlens.views.commits.files.layout": "tree",

    "rust-analyzer.linkedProjects": [
      "core/Cargo.toml",
      "relay/Cargo.toml",
      "cli/Cargo.toml",
      "tui/Cargo.toml",
      "e2e/Cargo.toml",
      "linux-gtk/Cargo.toml"
    ],
    "rust-analyzer.rustfmt.enableRangeFormatting": true,
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.check.allTargets": true,
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.inlayHints.parameterHints.enable": false,
    "rust-analyzer.inlayHints.typeHints.enable": true,
    "rust-analyzer.inlayHints.chainingHints.enable": false,
    "rust-analyzer.inlayHints.closureReturnTypeHints.enable": "never",
    "rust-analyzer.lens.enable": true,
    "rust-analyzer.lens.run.enable": true,
    "rust-analyzer.lens.debug.enable": true,
    "rust-analyzer.lens.implementations.enable": false,
    "rust-analyzer.lens.references.adt.enable": false,
    "rust-analyzer.lens.references.trait.enable": false,
    "rust-analyzer.lens.references.enumVariant.enable": false,
    "rust-analyzer.hover.actions.run.enable": true,
    "rust-analyzer.hover.actions.debug.enable": true,

    "workbench.colorCustomizations": {
      "editorInlayHint.foreground": "#888888",
      "editorInlayHint.background": "#00000000"
    },

    "[rust]": {
      "editor.defaultFormatter": "rust-lang.rust-analyzer",
      "editor.formatOnSave": true
    },

    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[html]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },

    "[swift]": {
      "editor.defaultFormatter": "vknabel.vscode-apple-swift-format",
      "editor.formatOnSave": true
    },

    "[kotlin]": {
      "editor.defaultFormatter": "fwcd.kotlin",
      "editor.formatOnSave": true
    },

    "[yaml]": {
      "editor.defaultFormatter": "redhat.vscode-yaml",
      "editor.formatOnSave": true
    },

    "[toml]": {
      "editor.defaultFormatter": "tamasfe.even-better-toml",
      "editor.formatOnSave": true
    },

    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },

    "[gherkin]": {
      "editor.defaultFormatter": "alexkrechik.cucumberautocomplete",
      "editor.formatOnSave": true
    },

    "prettier.singleQuote": true,
    "prettier.trailingComma": "es5",
    "prettier.tabWidth": 2,

    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact"
    ],

    "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK", "XXX"],
    "todo-tree.highlights.defaultHighlight": {
      "type": "text",
      "foreground": "#fff",
      "background": "#ffbd2a",
      "opacity": 50,
      "gutterIcon": true
    },
    "todo-tree.highlights.customHighlight": {
      "FIXME": { "background": "#ff5555" },
      "BUG": { "background": "#ff5555" }
    },
    "todo-tree.filtering.excludeGlobs": ["**/node_modules/**", "**/target/**"],

    "cucumberautocomplete.steps": [
      "features/step_definitions/**/*.rs",
      "e2e/tests/**/*.rs"
    ],
    "cucumberautocomplete.strictGherkinCompletion": true,

    "testing.automaticallyOpenPeekView": "failureVisible",
    "testing.defaultGutterClickAction": "run"
  },
  "extensions": {
    "recommendations": [
      "rust-lang.rust-analyzer",
      "tamasfe.even-better-toml",
      "vadimcn.vscode-lldb",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "nicknisi.solid-vscode",
      "fwcd.kotlin",
      "sswg.swift-lang",
      "redhat.vscode-yaml",
      "alexkrechik.cucumberautocomplete",
      "usernamehw.errorlens",
      "gruntfuggly.todo-tree",
      "christian-kohler.path-intellisense",
      "bierner.markdown-mermaid"
    ]
  }
}